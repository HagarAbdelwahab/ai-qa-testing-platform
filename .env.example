# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PASSWORD=
JIRA_PROJECT_KEY=
JIRA_PROJECT_ID=
JIRA_OWNER_ACCOUNT_ID=
JIRA_BOARD_NAME=

# AIO Tests (tokens are auto-refreshed via Playwright when possible)
AIO_TOKEN=
AIO_CSRF=
AIO_SESSION=
AIO_BASE_URL=https://tcms.aiojiraapps.com/aio-tcms/rest/aio-tcms/1.0
AIO_ORIGIN=https://your-org.atlassian.net
AIO_PAGE_URL=

# AI provider: an Anthropic API key, or leave empty to use the logged-in Claude Code CLI
ANTHROPIC_API_KEY=
# Model for analysis (test case generation, test-summary scope): opus | sonnet | full model id
ANALYSIS_MODEL=opus

# Team first names, comma-separated (used to classify assignees)
FE_TEAM=
BE_TEAM=
QA_TEAM=

PLAYWRIGHT_REPO_PATH=

# Context + code repos (story review / reconciliation); defaults assume sibling folders
CONTEXT_REPO_PATH=
CONTEXT_BASE_BRANCH=master
BE_REPO_PATH=
FE_REPO_PATH=
CODE_BASE_BRANCH=production
RECONCILE_FETCH=true
RECONCILE_ENV_BRANCHES=qa,preprod
